---
import { profile } from '../data/profile';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [{ href: '/resume/', label: 'Résumé' }] as const;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">MW</span>
      <span class="brand__name">{profile.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={path === href.replace(/\/$/, '') ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li><a href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
        <li>
          <button class="theme-toggle" type="button" data-action="toggle-theme" aria-label="Toggle dark mode">
            <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.5"></circle><path
                d="M12 1.5v3M12 19.5v3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M1.5 12h3M19.5 12h3M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"
              ></path></svg
            >
            <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path></svg
            >
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
