    <h1>404</h1>
    <p>That page doesn't exist. It may have moved when the site was rebuilt.</p>
    <div class="actions actions--center">
      <a class="button button--primary" href="/">Home</a>
      <a class="button" href="/resume/">Résumé</a>
    </div>
  </section>
</Base>
